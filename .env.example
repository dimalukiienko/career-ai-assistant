# ---- Server ----
PORT=8080
# Public base URL of this service (no trailing slash). Used for OAuth redirect + webhook.
# Locally this is your tunnel URL, e.g. https://your-tunnel.trycloudflare.com
PUBLIC_URL=http://localhost:8080

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Random secret; sent to Telegram on setWebhook and verified on every update.
TELEGRAM_WEBHOOK_SECRET=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Max tool-calling steps per message (safety cap).
AGENT_MAX_STEPS=8

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to ${PUBLIC_URL}/oauth/google/callback if unset.
GOOGLE_REDIRECT_URI=

# ---- OAuth state signing ----
# Random 32+ char secret used to HMAC-sign OAuth state + bot start links.
OAUTH_STATE_SECRET=

# ---- Token encryption ----
# If set, refresh tokens are envelope-encrypted via Cloud KMS using this key.
# Format: projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
KMS_KEY_NAME=
# Dev fallback when KMS_KEY_NAME is unset: base64-encoded 32-byte AES key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_ENCRYPTION_KEY=

# ---- Supabase (persistent token storage) ----
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# service_role key (server-side only, keep secret). Settings → API in the dashboard.
SUPABASE_SERVICE_ROLE_KEY=
